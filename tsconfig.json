{
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["scripts", "test", "contracts", "ignition"],
  "exclude": ["node_modules", "frontend"]
}
